{
  "Type": "Generic",
  "Parameters": {
    "Invulnerable": { "Value": false, "Description": "Whether the NPC is invulnerable." },
    "MemoriesNameOverride": { "Value": "Aetherhaven_Guard_Mage", "Description": "Memory name override" },
    "NameTranslationKey": {
      "Value": "aetherhaven_ui_journal_items_tail.npcRoles.Aetherhaven_Guard.name",
      "Description": "Translation key for NPC name display"
    },
    "ViewRange": { "Value": 24, "Description": "Combat detection range for aggressive mobs" },
    "TooCloseDistance": { "Value": 5, "Description": "Back away when hostiles enter this range" },
    "DesiredRangedDistance": { "Value": [8, 14], "Description": "Preferred staff casting range" },
    "AetherhavenWanderPhaseTime": { "Value": [6, 14], "Description": "Patrol wander phase (seconds)" },
    "AetherhavenPausePhaseTime": { "Value": [2, 5], "Description": "Patrol pause (seconds)" }
  },
  "StartState": "Idle",
  "DefaultNPCAttitude": "Neutral",
  "DefaultPlayerAttitude": "Neutral",
  "Appearance": "Male_Human_01",
  "MaxHealth": 90,
  "IsMemory": false,
  "MemoriesNameOverride": { "Compute": "MemoriesNameOverride" },
  "DisableDamageGroups": ["Self", "Player"],
  "BusyStates": ["Idle", "Combat"],
  "Invulnerable": { "Compute": "Invulnerable" },
  "KnockbackScale": 0.5,
  "HotbarItems": ["Weapon_Staff_Iron"],
  "OverrideHeadPitchAngle": true,
  "HeadPitchAngleRange": [-89, 89],
  "HotbarSize": 3,
  "OffHandSlots": 2,
  "MotionControllerList": [
    {
      "Type": "Walk",
      "MaxWalkSpeed": 5.5,
      "Gravity": 10,
      "RunThreshold": 0.3,
      "MaxFallSpeed": 15,
      "MaxRotationSpeed": 360,
      "Acceleration": 10
    }
  ],
  "StateTransitions": [
    {
      "States": [{ "To": ["Idle", "Combat"], "From": [] }],
      "Actions": [
        { "Type": "Inventory", "Operation": "EquipHotbar", "UseTarget": false, "Slot": 0 }
      ]
    }
  ],
  "Instructions": [
    {
      "Continue": true,
      "Instructions": [
        {
          "Continue": true,
          "Sensor": { "Type": "Any", "Once": true },
          "Actions": [
            { "Type": "Inventory", "Operation": "EquipHotbar", "UseTarget": false, "Slot": 0 }
          ]
        }
      ]
    },
    {
      "Instructions": [
        {
          "Sensor": { "Type": "State", "State": "Idle" },
          "Instructions": [
            {
              "Reference": "Component_Instruction_Aetherhaven_Guard_Idle_Aggro",
              "Modify": {
                "_ExportStates": ["Combat"],
                "ViewRange": { "Compute": "ViewRange" }
              }
            },
            {
              "Reference": "Component_Instruction_Aetherhaven_Guard_Rect_Wander_Idle",
              "Modify": {
                "WanderRectTimer": { "Compute": "AetherhavenWanderPhaseTime" },
                "PauseTimer": { "Compute": "AetherhavenPausePhaseTime" }
              }
            }
          ]
        },
        {
          "Sensor": { "Type": "State", "State": "Combat" },
          "Instructions": [
            {
              "Reference": "Component_Instruction_Aetherhaven_Guard_Staff_Combat",
              "Modify": {
                "ViewRange": { "Compute": "ViewRange" },
                "TooCloseDistance": { "Compute": "TooCloseDistance" },
                "DesiredRangedDistance": { "Compute": "DesiredRangedDistance" }
              }
            },
            {
              "Sensor": {
                "Type": "And",
                "Sensors": [
                  {
                    "Type": "Not",
                    "Sensor": {
                      "Type": "Mob",
                      "Range": { "Compute": "ViewRange" },
                      "LockOnTarget": false,
                      "Filters": [{ "Type": "NPCGroup", "IncludeGroups": ["Aggressive"] }],
                      "Collector": { "Type": "CombatTargets" }
                    }
                  },
                  { "Type": "Not", "Sensor": { "Type": "HasHostileTargetMemory" } }
                ]
              },
              "Actions": [{ "Type": "State", "State": "Idle" }]
            }
          ]
        }
      ]
    }
  ],
  "NameTranslationKey": { "Compute": "NameTranslationKey" }
}
