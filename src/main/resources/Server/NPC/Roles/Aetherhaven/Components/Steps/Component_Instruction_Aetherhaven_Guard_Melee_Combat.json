{
  "Type": "Component",
  "Class": "Instruction",
  "Interface": "Hytale.Instruction",
  "$Comment": "Melee combat: MaintainDistance strafing + Push separation on the role keeps co-attacking knights from stacking.",
  "Parameters": {
    "ViewRange": {
      "Value": 24,
      "Description": "Combat awareness range"
    },
    "AttackDistance": {
      "Value": 2.5,
      "Description": "Melee attack range"
    },
    "DesiredAttackDistanceRange": {
      "Value": [2, 2.5],
      "Description": "Preferred melee engagement band (skeleton knight style)"
    },
    "CombatBehaviorDistance": {
      "Value": 24,
      "Description": "Distance within which combat positioning runs"
    },
    "StrafingDurationRange": {
      "Value": [0.4, 1],
      "Description": "How long to strafe while maintaining distance"
    },
    "StrafingFrequencyRange": {
      "Value": [0.5, 1.5],
      "Description": "How often to strafe while maintaining distance"
    },
    "MeleeAttack": {
      "Value": "Root_NPC_Attack_Melee",
      "Description": "Melee attack interaction root"
    },
    "AttackPauseRange": {
      "Value": [1, 2],
      "Description": "Pause between melee swings"
    },
    "CombatAttackPreDelay": {
      "Value": [0.15, 0.35],
      "Description": "Brief stop before swinging so the hit connects"
    }
  },
  "Content": {
    "Instructions": [
      {
        "Continue": true,
        "Sensor": { "Type": "Damage", "Combat": true },
        "Actions": [
          { "Type": "AddToHostileTargetMemory" },
          { "Type": "OverrideAttitude", "Attitude": "Hostile", "Duration": 60 }
        ]
      },
      {
        "Continue": true,
        "Sensor": {
          "Type": "Target",
          "Range": { "Compute": "CombatBehaviorDistance" },
          "Filters": [{ "Type": "LineOfSight" }]
        },
        "HeadMotion": { "Type": "Aim", "RelativeTurnSpeed": 1.5, "HitProbability": 1.0 }
      },
      {
        "Continue": true,
        "Sensor": {
          "Type": "Target",
          "Range": { "Compute": "AttackDistance" },
          "Filters": [{ "Type": "LineOfSight" }]
        },
        "ActionsBlocking": true,
        "HeadMotion": { "Type": "Aim", "RelativeTurnSpeed": 1.5, "HitProbability": 1.0 },
        "Actions": [
          { "Type": "Timeout", "Delay": { "Compute": "CombatAttackPreDelay" } },
          {
            "Type": "Attack",
            "Attack": { "Compute": "MeleeAttack" },
            "AvoidFriendlyFire": true,
            "AttackPauseRange": { "Compute": "AttackPauseRange" }
          }
        ]
      },
      {
        "Continue": true,
        "Sensor": {
          "Type": "Target",
          "Range": { "Compute": "CombatBehaviorDistance" },
          "Filters": [{ "Type": "LineOfSight" }]
        },
        "BodyMotion": {
          "Type": "MaintainDistance",
          "DesiredDistanceRange": { "Compute": "DesiredAttackDistanceRange" },
          "MoveThreshold": 0.3,
          "StrafingDurationRange": { "Compute": "StrafingDurationRange" },
          "StrafingFrequencyRange": { "Compute": "StrafingFrequencyRange" },
          "RelativeForwardsSpeed": 0.65,
          "RelativeBackwardsSpeed": 0.4
        }
      }
    ]
  }
}
