{
  "Type": "Component",
  "Class": "Instruction",
  "Interface": "Hytale.Instruction",
  "$Comment": "Custom bow combat for Aetherhaven archer guards.",
  "Parameters": {
    "ViewRange": {
      "Value": 24,
      "Description": "Combat awareness range"
    },
    "TooCloseDistance": {
      "Value": 5,
      "Description": "Back away when hostiles enter this range"
    },
    "DesiredRangedDistance": {
      "Value": [8, 14],
      "Description": "Preferred bow engagement band"
    },
    "RangedAttack": {
      "Value": "Skeleton_Archer_Bow_Shoot",
      "Description": "Bow attack interaction"
    }
  },
  "Content": {
    "Sensor": {
      "Type": "Or",
      "Sensors": [
        {
          "Type": "Mob",
          "Range": { "Compute": "ViewRange" },
          "LockOnTarget": true,
          "Filters": [{ "Type": "NPCGroup", "IncludeGroups": ["Aggressive"] }],
          "Collector": { "Type": "CombatTargets" }
        },
        { "Type": "HasHostileTargetMemory" }
      ]
    },
    "Instructions": [
      {
        "Continue": true,
        "Sensor": { "Type": "Damage", "Combat": true },
        "Actions": [{ "Type": "AddToHostileTargetMemory" }]
      },
      {
        "Continue": true,
        "Sensor": { "Type": "Target", "Range": { "Compute": "TooCloseDistance" } },
        "BodyMotion": {
          "Type": "Flee",
          "SlowDownDistance": 6,
          "StopDistance": 10,
          "RelativeSpeed": 0.65
        }
      },
      {
        "Continue": true,
        "Sensor": {
          "Type": "Target",
          "Range": { "Compute": "ViewRange" },
          "Filters": [{ "Type": "LineOfSight" }]
        },
        "HeadMotion": { "Type": "Aim", "RelativeTurnSpeed": 0.5, "HitProbability": 1.0 }
      },
      {
        "Sensor": {
          "Type": "Target",
          "Range": { "Compute": "ViewRange" },
          "Filters": [{ "Type": "LineOfSight" }]
        },
        "ActionsBlocking": true,
        "BodyMotion": {
          "Type": "MaintainDistance",
          "DesiredDistanceRange": { "Compute": "DesiredRangedDistance" },
          "MoveThreshold": 0.2,
          "RelativeForwardsSpeed": 0.4,
          "RelativeBackwardsSpeed": 0.55
        },
        "Actions": [
          {
            "Type": "Attack",
            "Attack": { "Compute": "RangedAttack" },
            "BallisticMode": "Short",
            "AimingTimeRange": [0.4, 1.2],
            "LineOfSight": true,
            "AvoidFriendlyFire": true,
            "AttackPauseRange": [1.5, 2.5]
          }
        ]
      },
      {
        "Sensor": { "Type": "Target", "Range": { "Compute": "ViewRange" } },
        "BodyMotion": {
          "Type": "Seek",
          "SlowDownDistance": 12,
          "StopDistance": 8,
          "RelativeSpeed": 0.5
        }
      }
    ]
  }
}
