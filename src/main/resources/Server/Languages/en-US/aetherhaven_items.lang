# Split from server.lang — keys unchanged (same lookups as before; Java uses server.<key>).
# Bundle: items, path tool, plot tokens through quest journal item

items.Aetherhaven_Firewood.name=Firewood
items.Aetherhaven_Firewood.description=Dried log bundles. Burns about twice as long as charcoal in furnaces and campfires.

items.Aetherhaven_Root_Remover.name=Root Remover
items.Aetherhaven_Root_Remover.description=Right click a tree trunk to pull up buried roots below the ground. The wood lands at your feet and the hole fills with dirt.

items.Aetherhaven_Growth_Serum.name=Growth Serum
items.Aetherhaven_Growth_Serum.description=Use on a young animal to help it grow up right away. Uses one vial.

items.Aetherhaven_Hunting_Knife.name=Hunting Knife
items.Aetherhaven_Hunting_Knife.description=A sharp knife for hunters. Kill animals with it to sometimes get extra raw meat, hide, and feathers.

items.Aetherhaven_Wood_Scaffold.name=Wood scaffolding
items.Aetherhaven_Wood_Scaffold.description=Climb like a ladder. Right-click places like a normal block. Hold Use (F) while aiming at scaffolding to extend the tower from the side or branch horizontally from the top face. Breaking the bottom unsupported piece collapses the stack.
items.Aetherhaven_Wood_Scaffold.legendUse=Use (F): extend tower / branch from top while aiming at scaffold. Right-click: normal block placement.

# === Items: town, plot tokens, currency, geodes, barter, shelves, sprinklers (items.*) ===
items.Aetherhaven_Plot_Sign.name=Plot sign
items.Aetherhaven_Plot_Sign.description=Marks where a building can be placed. Craft plot tokens at a plot crafting bench.

items.Aetherhaven_Charter.name=Town charter
items.Aetherhaven_Charter.description=Place to found a town. Each player may have one town per world. Use to open town info.

items.Aetherhaven_Town_Planning_Desk.name=Town planning desk
items.Aetherhaven_Town_Planning_Desk.description=Town planning bench. Charters, building staves, the plot crafting bench, and related recipes. Craft at a workbench.
items.Aetherhaven_Plot_Crafting_Bench.name=Plot crafting bench
items.Aetherhaven_Plot_Crafting_Bench.description=Craft plot tokens for buildings and decorations. Use to pick a building, preview it, and pay gold to get a token. Craft at your town planning desk.
items.Aetherhaven_Charter_Amendments_Table.name=Charter amendments table
items.Aetherhaven_Charter_Amendments_Table.description=Records how the town's tithe is counted and what trade the charter favors. Use to open amendments once your population supports it. Craft at your town planning desk; <color is="#ffa726">you must know the schematic</color>.
items.Aetherhaven_Banquet_Table.name=Banquet table
items.Aetherhaven_Banquet_Table.description=A long table for town feasts. Place in your territory and use it to serve a civic feast. Craft at the town planning desk once someone in town shares the pattern.
items.Aetherhaven_Founder_Monument.name=Founder monument
items.Aetherhaven_Founder_Monument.description=A stone pedestal that holds a likeness of the founder. Place inside town territory to honor them; the treasury's morning share grows slightly while it stands. Only one per town.

benchCategories.aetherhaven.town_planning=Town planning
benchCategories.aetherhaven.plot_tokens=Plot tokens

items.Aetherhaven_Plot_Placement_Tool.name=Plot placement staff
items.Aetherhaven_Plot_Placement_Tool.description=Keep the matching plot token in your bags. Use this staff while aiming at the ground to see a ghost of the building. Nudge and turn it until it fits, then confirm to stake the plot. Cancel to clear the preview and use the staff again when you want a different spot.

items.Aetherhaven_Wall_Wand.name=Wall wand
items.Aetherhaven_Wall_Wand.description=Plan stone walls around your town. Secondary use opens a top down view to chain wall, gate, and tower pieces. Primary use on an existing piece lets you extend the wall or remove it. Each piece uses a plot sign and builds like other town plots.
items.Aetherhaven_Token_Wall.name=Wall piece marker
items.Aetherhaven_Token_Wall.description=Shows on wall plot signs during placement. Not used from your inventory.
items.Aetherhaven_Token_Wall_Gate.name=Gate piece marker
items.Aetherhaven_Token_Wall_Gate.description=Shows on gate plot signs during placement. Not used from your inventory.
items.Aetherhaven_Token_Wall_Tower.name=Tower piece marker
items.Aetherhaven_Token_Wall_Tower.description=Shows on tower plot signs during placement. Not used from your inventory.

items.Aetherhaven_Poi_Tool.name=POI debug tool
items.Aetherhaven_Poi_Tool.description=Edit town POI spots, place new POI markers in prefabs, and set adventurer spawn markers (permission: <color is="#5AB5B5">aetherhaven.poi.tool</color>). Press Q to cycle modes.
items.Aetherhaven_Poi_Tool.legendTitle=POI tool
items.Aetherhaven_Poi_Tool.legendPrimary=Primary: select nearest POI near the block
items.Aetherhaven_Poi_Tool.legendSecondary=Secondary: move selected POI to the block
items.Aetherhaven_Poi_Tool.legendUse=Use: set NPC path target for selected POI (Use on POI block clears)

