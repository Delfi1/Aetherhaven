$C = "../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 720);

    #Title {
      Label #MaterialPickerTitleText {
        Style: (...$C.@TitleStyle, HorizontalAlignment: Center);
        Padding: (Horizontal: 19);
        Text: "";
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);

      Label #MaterialPickerIntro {
        Anchor: (Bottom: 10);
        Style: (...$C.@DefaultLabelStyle, Wrap: true, HorizontalAlignment: Center, TextColor: #c8c0b0, FontSize: 12);
        Text: "";
      }

      Label #ErrMsg {
        Visible: false;
        Anchor: (Bottom: 8);
        Style: (...$C.@DefaultLabelStyle, Wrap: true, TextColor: #e8a0a0);
        Text: "";
      }

      Group #GridScroll {
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Anchor: (Height: 320, Bottom: 8);

        Group #PickerRows {
          LayoutMode: Top;
        }
      }

      Group #NavRow {
        LayoutMode: Center;
        Anchor: (Top: 6);

        $C.@TextButton #NavToProduction {
          TextTooltipStyle: $C.@DefaultTextTooltipStyle;
          TooltipText: "";
          Anchor: (Width: 220, Height: 38);
          Text: "";
        }
      }
    }
  }
}

$C.@BackButton {}
